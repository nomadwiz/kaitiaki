# Copy to .env and fill in. NEVER commit .env — see CLAUDE.md.
#
# Hardhat 3 does not read .env by itself. It resolves these through
# `configVariable()` in hardhat.config.ts, which reads either the environment
# or the encrypted keystore. The keystore is the safer route:
#
#     npx hardhat keystore set SEPOLIA_RPC_URL
#     npx hardhat keystore set SEPOLIA_PRIVATE_KEY
#
# This file exists so the variable names are settled in one place, and so the
# .gitignore rule that protects .env has something to be checked against.
#
# Nothing here is used before week 5. Test-network funds are acquired in week 2
# and held, because faucets are unreliable and week 5 cannot wait on one.

# JSON-RPC endpoint for the public test network.
SEPOLIA_RPC_URL=

# Deployer account: 0x-prefixed, 64 hex characters. A throwaway account holding
# test-network funds only. Never a real key, and never an account with value.
SEPOLIA_PRIVATE_KEY=

# Minimum balance required before a week 5 deployment.
# This is a public threshold and may be supplied as an environment variable.
SEPOLIA_MIN_BALANCE_WEI=
