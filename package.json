{
  "name": "kaitiaki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A body corporate treasury on a permissioned national housing chain. COMP842 Assignment 1.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "test:solidity": "hardhat test solidity",
    "test:mocha": "hardhat test mocha",
    "test:coverage": "hardhat test solidity --coverage",
    "test:gas": "hardhat test solidity --gas-stats",
    "check:config-secrets": "node scripts/check-config-secrets.mjs",
    "check:sepolia-account": "hardhat run scripts/check-sepolia-account.ts --network sepolia",
    "demo": "hardhat run scripts/demo.ts --network localhost",
    "demo:loop": "hardhat run scripts/demo-loop.ts --network localhost",
    "interface": "vite interface",
    "interface:build": "vite build interface",
    "typecheck": "tsc --noEmit",
    "lint": "solhint \"contracts/**/*.sol\"",
    "lint:fix": "solhint \"contracts/**/*.sol\" --fix",
    "format": "prettier --write \"contracts/**/*.sol\"",
    "format:check": "prettier --check \"contracts/**/*.sol\""
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chai": "^5.2.3",
    "@types/mocha": ">=10.0.10",
    "@types/node": "^22.8.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chai": "^6.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ethers": "^6.14.0",
    "forge-std": "git+https://github.com/foundry-rs/forge-std.git#v1.16.2",
    "hardhat": "^3.15.0",
    "lucide-react": "^1.52.0",
    "mocha": "^11.0.0",
    "prettier": "^3.9.8",
    "prettier-plugin-solidity": "^2.4.1",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "solhint": "^6.2.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
